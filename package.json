{
  "name": "store-platform",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:prepare && concurrently \"npm run dev --workspace @store/backend\" \"npm run dev --workspace @store/frontend\"",
    "dev:prepare": "npm run db:deploy && npm run db:seed",
    "dev:frontend": "npm run dev --workspace @store/frontend",
    "dev:backend": "npm run dev --workspace @store/backend",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:migrate": "npm run prisma:migrate --workspace @store/backend",
    "db:deploy": "npm run prisma:deploy --workspace @store/backend",
    "db:seed": "npm run prisma:seed --workspace @store/backend",
    "compose:up": "docker compose up --build",
    "compose:down": "docker compose down"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.1",
    "concurrently": "^9.1.2",
    "eslint": "^9.25.1",
    "globals": "^15.15.0"
  }
}
